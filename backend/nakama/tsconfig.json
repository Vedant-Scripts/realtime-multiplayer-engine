{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler", // Or "node"
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "isolatedModules": true, // Required for many bundlers
    "esModuleInterop": true,
    "rootDir": "./modules",
    "outDir": "./build"
  }
}